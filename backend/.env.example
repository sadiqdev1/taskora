APP_NAME=Taskora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://taskora-backend.onrender.com

# Frontend URL — update after deploying Next.js
FRONTEND_URL=https://taskora.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────────────────────
# Use PostgreSQL on Render (free tier available)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taskora
DB_USERNAME=taskora
DB_PASSWORD=

# ── Cache / Queue / Session ──────────────────────────────────────────────────
# Use 'database' on free Render plan (no Redis required)
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=3000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail — Resend ─────────────────────────────────────────────────────────────
# Free plan: only sends to YOUR account email until you verify a domain.
# To send to all users: verify taskora.io at resend.com/domains
# then set RESEND_DOMAIN_VERIFIED=true
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@taskora.io
MAIL_FROM_NAME=Taskora
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_DOMAIN_VERIFIED=false

# ── Paystack ──────────────────────────────────────────────────────────────────
# Use sk_live_... for production, sk_test_... for testing
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://taskora-backend.onrender.com/api/auth/google/callback

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

VITE_APP_NAME="${APP_NAME}"
